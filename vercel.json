{
  "crons": [
    {
      "path": "/api/daily-refresh",
      "schedule": "0 16 * * *"
    }
  ],
  "functions": {
    "api/portal.py": {
      "memory": 1024,
      "maxDuration": 60
    },
    "api/ai.py": {
      "memory": 512,
      "maxDuration": 60
    },
    "api/ai-report.py": {
      "memory": 1024,
      "maxDuration": 120
    },
    "api/daily-refresh.py": {
      "memory": 512,
      "maxDuration": 300
    }
  },
  "rewrites": [
    {
      "source": "/",
      "destination": "/api/portal?__path=/world3d"
    },
    {
      "source": "/portal/static/:file*",
      "destination": "/api/portal?__path=/static/:file*"
    },
    {
      "source": "/portal/:path*",
      "destination": "/api/portal?__path=/:path*"
    },
    {
      "source": "/static/:file*",
      "destination": "/api/portal?__path=/static/:file*"
    },
    {
      "source": "/案例/:path*",
      "destination": "/api/portal?__path=/案例/:path*"
    },
    {
      "source": "/%E6%A1%88%E4%BE%8B/:path*",
      "destination": "/api/portal?__path=/案例/:path*"
    },
    {
      "source": "/案例",
      "destination": "/api/portal?__path=/案例"
    },
    {
      "source": "/%E6%A1%88%E4%BE%8B",
      "destination": "/api/portal?__path=/案例"
    },
    {
      "source": "/落地",
      "destination": "/api/portal?__path=/落地"
    },
    {
      "source": "/%E8%90%BD%E5%9C%B0",
      "destination": "/api/portal?__path=/落地"
    },
    {
      "source": "/现场",
      "destination": "/api/portal?__path=/现场"
    },
    {
      "source": "/%E7%8E%B0%E5%9C%BA",
      "destination": "/api/portal?__path=/现场"
    },
    {
      "source": "/方法",
      "destination": "/api/portal?__path=/方法"
    },
    {
      "source": "/%E6%96%B9%E6%B3%95",
      "destination": "/api/portal?__path=/方法"
    },
    {
      "source": "/world3d",
      "destination": "/api/portal?__path=/world3d"
    },
    {
      "source": "/世界动态",
      "destination": "/api/portal?__path=/world3d"
    },
    {
      "source": "/%E4%B8%96%E7%95%8C%E5%8A%A8%E6%80%81",
      "destination": "/api/portal?__path=/world3d"
    },
    {
      "source": "/平面",
      "destination": "/api/portal?__path=/平面"
    },
    {
      "source": "/%E5%B9%B3%E9%9D%A2",
      "destination": "/api/portal?__path=/平面"
    },
    {
      "source": "/动态/:path*",
      "destination": "/api/portal?__path=/动态/:path*"
    },
    {
      "source": "/%E5%8A%A8%E6%80%81/:path*",
      "destination": "/api/portal?__path=/动态/:path*"
    },
    {
      "source": "/api/world.json",
      "destination": "/api/portal?__path=/api/world.json"
    }
  ]
}